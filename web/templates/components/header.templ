package components

// Header displays the site banner with title and tagline
templ Header() {
	<header class="w-full bg-white/60 backdrop-blur-sm border-b shadow-sm" style="border-color: rgba(77, 77, 64, 0.1);">
		<div class="max-w-7xl mx-auto px-8 py-6">
			<div class="flex flex-col">
				<h1 class="text-6xl font-bold tracking-tight font-mono" style="color: #4D4D40;">
				  INTERCEDE	
				</h1>
				<p class="text-xl font-light font-mono mt-2" style="color: #808073;">
					Share your heart with your church
				</p>
			</div>
		</div>
	</header>
}
