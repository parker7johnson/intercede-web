package components

templ ChurchCodeButton() {
	<button
		id="openChurchModalBtn"
		class="flex items-center px-2 my-2 hover:opacity-80 transition-opacity"
		style="color: #4D4D40;"
	>
		<span class="text-xl" id="lastChurchCode"></span>
		<svg class="w-6 h-6" style="color: #808073;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
		</svg>
	</button>
}
