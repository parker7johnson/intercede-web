package pages

import "github.com/parkerjohnson/intercede/web/templates/layouts"

// PraiseReportContent is the inner content for HTMX swaps
templ PraiseReportContent() {
<div class="px-4" id="praiseRequestContainer">
  <div class="max-w-3xl min-w-xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="prayer-header">Praise Report</h1>
      <p class="prayer-subheader">Share God's answers with your church</p>
    </div>
    <!-- Form -->
    <form id="praiseRequestForm" class="prayer-form">
      <!-- Title -->
      <div>
        <label for="title" class="prayer-label">
          Request Title <span class="required">*</span>
        </label>
        <input type="text" id="title" name="title" required placeholder="e.g., Health, Family, Work..."
          class="prayer-input" />
      </div>
      <div>
        <label for="request" class="prayer-label">
          Praise Report<span class="required">*</span>
        </label>
        <textarea id="request" name="request" required rows="8" placeholder="Share what God has done in your life..."
          class="prayer-textarea"></textarea>
      </div>
      <!-- Contact Info -->
      <div>
        <label for="contact" class="prayer-label">
          Contact Information (Optional)
        </label>
        <input type="text" id="contact" name="contact" placeholder="Email or phone number for follow-up"
          class="prayer-input" />
        <p class="prayer-helper-text">
          This will only be visible to church leadership
        </p>
      </div>
      <!-- Buttons -->
      <div class="prayer-buttons">
        <button type="button" class="prayer-btn-cancel" hx-get="/" hx-swap="innerHTML"
          hx-target="#mainContent">
          Cancel
        </button>
        <button type="submit" class="prayer-btn-submit" hx-get="/" hx-swap="innerHTML"
          hx-target="#mainContent">
          Submit Request
        </button>
      </div>
    </form>
  </div>
</div>
}

templ PraiseReport() {
@layouts.Base("Praise Report - Intercede") {
  @PraiseReportContent()
}
}
